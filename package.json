{
  "name": "back",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun  --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target=node",
    "start": "tsx watch src/index.ts",
    "format": "prettier --write .",
