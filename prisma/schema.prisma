generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aspirante {
  id              String      @id @default(uuid())
  nombres         String
  apellidos       String
  tipoDocumento   String
  numeroDocumento String      @unique
  correo          String      @unique
  telefono        String?
  fechaNacimiento DateTime?
  direccion       String?
  ciudad          String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  solicitudes     Solicitud[]

  @@map("aspirantes")
}

model ProgramaAcademico {
  id          String      @id @default(uuid())
  nombre      String
  codigo      String      @unique
  facultad    String?
  jornada     String?
  activo      Boolean     @default(true)
  solicitudes Solicitud[]

  @@map("programas_academicos")
}

model Solicitud {
  id                     String                  @id @default(uuid())
  codigo                 String                  @unique @default(cuid())
  aspiranteId            String
  programaId             String
  estado                 EstadoSolicitud         @default(FORMULARIO_COMPLETADO)
  formularioCompletadoEn DateTime?
  pagoInscripcionEn      DateTime?
  valorPagoInscripcion   Decimal?                @db.Decimal(10, 2)
  bachillerValidado      Boolean                 @default(false)
  puntajeIcfes           Int?
  icfesValidado          Boolean                 @default(false)
  requisitosValidados    Boolean                 @default(false)
  fechaValidacion        DateTime?
  validadoPorId          String?
  aprobadoPreliminarEn   DateTime?
  fechaLimiteRespuesta   DateTime?
  matriculaPagadaEn      DateTime?
  valorMatricula         Decimal?                @db.Decimal(10, 2)
  cuentaActivadaEn       DateTime?
  codigoEstudiante       String?                 @unique
  archivadoEn            DateTime?
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  decisiones             DecisionAdmision[]
  documentos             Documento[]
  entrevistas            Entrevista[]
  observaciones          ObservacionAdmisiones[]
  aspirante              Aspirante               @relation(fields: [aspiranteId], references: [id])
  programa               ProgramaAcademico       @relation(fields: [programaId], references: [id])
  validadoPor            Usuario?                @relation("SolicitudesValidadas", fields: [validadoPorId], references: [id])

  @@index([estado])
  @@map("solicitudes")
}

/// Documentos requeridos en el paso 3 (identidad, foto, certificados)
model Documento {
  id          String          @id @default(uuid())
  solicitudId String
  tipo        TipoDocumento
  estado      EstadoDocumento @default(PENDIENTE)
  urlArchivo  String?
  observacion String?
  cargadoEn   DateTime?
  validadoEn  DateTime?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  solicitud   Solicitud       @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@unique([solicitudId, tipo])
  @@map("documentos")
}

/// Notificaciones de observaciones de Admisiones (nodo "4b" del BPMN, loop de retorno al paso 4)
model ObservacionAdmisiones {
  id           String    @id @default(uuid())
  solicitudId  String
  motivo       String
  detalle      String?
  resuelta     Boolean   @default(false)
  emitidaPorId String
  createdAt    DateTime  @default(now()) @map("created_at")
  emitidaPor   Usuario   @relation(fields: [emitidaPorId], references: [id])
  solicitud    Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("observaciones_admisiones")
}

model Usuario {
  id                       String                  @id @default(uuid())
  nombres                  String
  apellidos                String
  correo                   String                  @unique
  rol                      RolUsuario
  activo                   Boolean                 @default(true)
  /// Hash bcrypt de la contraseña. Null = el usuario aún no tiene acceso al sistema
  passwordHash             String?                 @map("password_hash")
  ultimoAcceso             DateTime?               @map("ultimo_acceso")
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  ratificaciones           DecisionAdmision[]      @relation("DecisionesRatificadas")
  decisionesTomadas        DecisionAdmision[]      @relation("DecisionesTomadas")
  entrevistasComoEvaluador Entrevista[]            @relation("EntrevistaEvaluador")
  observacionesEmitidas    ObservacionAdmisiones[]
  solicitudesValidadas     Solicitud[]             @relation("SolicitudesValidadas")

  @@map("usuarios")
}

model Entrevista {
  id                   String                @id @default(uuid())
  solicitudId          String
  tipo                 TipoEntrevista
  estado               EstadoEntrevista      @default(PENDIENTE)
  evaluadorId          String?
  fechaProgramada      DateTime?
  fechaRealizada       DateTime?
  modalidad            String?
  lugarOEnlace         String?
  motivoReprogramacion String?
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  evaluador            Usuario?              @relation("EntrevistaEvaluador", fields: [evaluadorId], references: [id])
  solicitud            Solicitud             @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  evaluacionAcademica  EvaluacionAcademica?
  evaluacionCapellania EvaluacionCapellania?

  @@index([solicitudId, tipo])
  @@map("entrevistas")
}

/// Rúbrica de la entrevista con Capellanía (paso 6a): valores, proyecto de vida,
/// convivencia, compromiso con el Manual de Convivencia y actitud.
/// Cada criterio se puntúa de 1 a 5.
model EvaluacionCapellania {
  id                      String     @id @default(uuid())
  entrevistaId            String     @unique
  valoresPrincipiosEticos Int
  proyectoDeVida          Int
  convivenciaComunitaria  Int
  compromisoReglamento    Int
  actitudDisposicion      Int
  /// Promedio calculado de los 5 criterios (se recomienda recalcular en la capa de aplicación)
  promedio                Decimal    @db.Decimal(3, 2)
  observaciones           String?
  evaluadaEn              DateTime   @default(now())
  entrevista              Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("evaluaciones_capellania")
}

/// Rúbrica de la entrevista Académica con Coordinación/Decanatura (paso 6b):
/// aptitud académica, perfil para el programa, comunicación, pensamiento
/// crítico y motivación intrínseca. Cada criterio se puntúa de 1 a 5.
model EvaluacionAcademica {
  id                      String     @id @default(uuid())
  entrevistaId            String     @unique
  aptitudAcademica        Int
  perfilParaElPrograma    Int
  habilidadesComunicacion Int
  pensamientoCritico      Int
  motivacionIntrinseca    Int
  /// Promedio calculado de los 5 criterios
  promedio                Decimal    @db.Decimal(3, 2)
  conceptoAcademico       String?
  recomendacionFinal      String?
  evaluadaEn              DateTime   @default(now())
  entrevista              Entrevista @relation(fields: [entrevistaId], references: [id], onDelete: Cascade)

  @@map("evaluaciones_academicas")
}

/// Decisión de Coordinación tras evaluar entrevistas, con flujo de
/// ratificación de Vicerrectoría (rombo "Si/No" -> Loop de corrección o Matrícula)
model DecisionAdmision {
  id                     String             @id @default(uuid())
  solicitudId            String
  tipo                   TipoDecision
  tomadaPorId            String
  tomadaEn               DateTime           @default(now())
  justificacion          String?
  estadoRatificacion     EstadoRatificacion @default(PENDIENTE)
  ratificadaPorId        String?
  ratificadaEn           DateTime?
  comentarioRatificacion String?
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  ratificadaPor          Usuario?           @relation("DecisionesRatificadas", fields: [ratificadaPorId], references: [id])
  solicitud              Solicitud          @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  tomadaPor              Usuario            @relation("DecisionesTomadas", fields: [tomadaPorId], references: [id])

  @@index([solicitudId])
  @@map("decisiones_admision")
}

/// Estado macro de la solicitud, mapeado a las etapas del BPMN (pasos 1-9)
enum EstadoSolicitud {
  FORMULARIO_COMPLETADO
  PAGO_INSCRIPCION
  DOCUMENTOS_CARGADOS
  VALIDACION_REQUISITOS
  OBSERVADO
  ADMITIDO_PRELIMINAR
  EN_ENTREVISTA_CAPELLANIA
  EN_ENTREVISTA_ACADEMICA
  CORRECCION_PERFIL
  EN_RATIFICACION
  ADMITIDO
  RECHAZADO
  MATRICULADO
  CUENTA_ACTIVADA
  ARCHIVADO
}

/// Tipo de documento exigido en el paso 3
enum TipoDocumento {
  DOCUMENTO_IDENTIDAD
  FOTO
  CERTIFICADO_BACHILLER
  RESULTADO_ICFES
  OTRO
}

enum EstadoDocumento {
  PENDIENTE
  CARGADO
  VALIDADO
  RECHAZADO
}

/// Rol interno del usuario/funcionario dentro del sistema (no el aspirante)
enum RolUsuario {
  ADMISIONES
  CAPELLAN
  COORDINADOR_PROGRAMA
  VICERRECTORIA
  OFICINA_FINANCIERA
  REGISTRO_ACADEMICO
  ADMIN
}

/// Corresponde a los dos gateways de entrevista (Capellán / Coordinación)
enum TipoEntrevista {
  CAPELLANIA
  ACADEMICA
}

enum EstadoEntrevista {
  PENDIENTE
  REPROGRAMADA
  COMPLETADA
  CANCELADA
}

/// Decisión tomada por Coordinación tras las entrevistas (paso 6c/6d)
enum TipoDecision {
  NOTIFICAR_ADMISION
  SOLICITAR_CORRECCION_PERFIL
  RECHAZAR
}

/// Estado del flujo de ratificación por Vicerrectoría (rombo "Si/No" del BPMN)
enum EstadoRatificacion {
  PENDIENTE
  RATIFICADA
  RECHAZADA
}
